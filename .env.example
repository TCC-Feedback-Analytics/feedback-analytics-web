# Base da API do frontend. Vazia nos dois ambientes: no local, o Vite repassa /api ao
# gateway em http://localhost:3000 (server.proxy no vite.config.ts); em produção, a
# Vercel repassa ao gateway (vercel.json).
VITE_API_BASE_URL=
# Gateway direto para as rotas públicas que contam por IP (formulário do cliente, reenvio).
# Local: vazia (usa a de cima). Produção: URL pública do gateway.
VITE_PUBLIC_API_BASE_URL=
# "true" mostra o "Continuar com Google" no login e no cadastro. Só ligue com
# GOOGLE_CLIENT_ID e GOOGLE_CLIENT_SECRET configurados no gateway.
VITE_GOOGLE_AUTH_ENABLED=false
